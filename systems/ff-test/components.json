{
  "components": [
    {
      "name": "button",
      "label": "버튼",
      "font": "--font-new",
      "weight": "--font-weight-medium",
      "radius": "--radius-md",
      "borderWidth": "--border-width-thin",
      "icon": "arrow-right",
      "iconPos": "none",
      "variants": [
        {
          "name": "primary",
          "states": {
            "default": {
              "bg": "--color-blue-500",
              "text": "--color-white"

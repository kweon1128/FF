      "sizes": [
        {
          "name": "sm",
          "padX": "--spacing-3",
          "padY": "--spacing-2",
          "textSize": "--text-sm",
          "gap": "--spacing-2"
        },
        {
          "name": "md",
          "padX": "--spacing-4",
          "padY": "--spacing-3",
          "textSize": "--text-base",
          "gap": "--spacing-2"
        },
        {
          "name": "new"
        }
      ]
